# ==============================================================================
# Git Ignore Configuration - Executive Portfolio Website
# ==============================================================================

# --- Environment & Secret Files (CRITICAL) ---
.env
.env*.local
.env.local
.env.development
.env.test
.env.production
.env.prod
.env.staging
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519
*.secret
*.secrets
secrets.*
credentials.json
service-account*.json
*.token

# Explicitly permit example templates
!.env.example
!.env*.example

# --- Dependencies ---
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# --- Next.js Build & Outputs ---
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts.bak

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
coverage/
.nyc_output/
*.lcov
test-results/
.vitest/

# --- Temporary & Cache Directories ---
.turbo/
.vercel
.cache/
.parcel-cache/

# --- Operating System & IDE Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
