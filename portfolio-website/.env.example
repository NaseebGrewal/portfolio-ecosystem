# ==============================================================================
# Executive Portfolio Environment Configuration
# ==============================================================================
# Copy this file to .env.local to customize with your real URLs and credentials.
# Next.js automatically injects NEXT_PUBLIC_* variables into the client bundle.
# ==============================================================================

# --- Personal & Contact Information ---
NEXT_PUBLIC_CANDIDATE_NAME="Firstname Lastname, M.Sc."
NEXT_PUBLIC_CANDIDATE_TITLE="Senior AI Solutions Architect | R&D Digitalization & Full-Stack Lead"
NEXT_PUBLIC_CANDIDATE_LOCATION="Germany"
# Private inbox for the /api/contact route — server-side ONLY, never NEXT_PUBLIC_.
CANDIDATE_EMAIL="your-private-inbox@example.com"
NEXT_PUBLIC_GITHUB_URL="https://github.com/your-username"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/your-profile"
NEXT_PUBLIC_PORTFOLIO_URL="https://your-portfolio-domain.vercel.app"

# --- Live Microservice API Endpoints & Automated Swagger Sandboxes ---
# Note: The portfolio website automatically derives the "Live Sandbox" Swagger links
# for all microservices directly from these API endpoints (appending /docs).
NEXT_PUBLIC_MATERIALS_API_URL="http://localhost:8000"
NEXT_PUBLIC_MATERIALS_FRONTEND_URL="http://localhost:3001"
NEXT_PUBLIC_CHEMAGENT_API_URL="http://localhost:8001"
NEXT_PUBLIC_RHEOLOGY_API_URL="http://localhost:8002"
NEXT_PUBLIC_GATEWAY_API_URL="http://localhost:8003"
NEXT_PUBLIC_DOC_INTELLIGENCE_API_URL="http://localhost:8004"
NEXT_PUBLIC_CLINICAL_TRIAGE_API_URL="http://localhost:8005"
NEXT_PUBLIC_CODE_REVIEW_API_URL="http://localhost:8006"

# Note: Project GitHub links are auto-derived from NEXT_PUBLIC_GITHUB_URL +
# the monorepo project path (portfolio-ecosystem/tree/main/projects/<dir>),
# so no per-project GitHub env vars are required.


# AI API Keys (For Development Purposes Only - Do Not Expose in Production)
NEXT_PUBLIC_GOOGLE_AI_API_KEY="api from google ai studio"
NEXT_PUBLIC_GOOGLE_AI_MODEL_ID="your default model"

AI_GATEWAY_API_KEY="api value from vercel"


# Email Service API Key (For Development Purposes Only - Do Not Expose in Production)
RESEND_API_KEY="your resend api"

RESEND_EMAIL_DOMAIN="your verified domain for ex: johndoe.com, doejohn.de johnnycodes.io etc"
# Sender identities are auto-derived from the verified domain — no extra vars needed:
#   Notification (to you):   <NEXT_PUBLIC_CANDIDATE_NAME> <contact@RESEND_EMAIL_DOMAIN>
#   Confirmation (to sender): Portfolio <no-reply@RESEND_EMAIL_DOMAIN>


# For the professional picture, if there is a link for the hosted image
NEXT_PUBLIC_PROFILE_IMAGE_URL="link_if_avaiable_or a photo profile.png under public/profile.png"