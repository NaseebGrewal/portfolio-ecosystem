NEXT_PUBLIC_PROJECT_4_DEMO_URL="https://gateway.yourdomain.com"

# --- Live Microservice API Endpoints (Real-Time Fetching) ---
NEXT_PUBLIC_MATERIALS_API_URL="http://localhost:8000"
